import numpy as np
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D

# =====================================================================
# KINETIX-9: UNIFIED DIGITAL TWIN TELEMETRY DASHBOARD
# =====================================================================
fig = plt.figure(figsize=(15, 10))
fig.suptitle('Kinetix-9 CPFR Engine: Unified Multi-Layer Telemetry Dashboard', fontsize=14, fontweight='bold', y=0.95)

# --- PANEL 1: LAYER A (Direct Electromagnetic Induction) ---
ax1 = fig.add_subplot(231)
t_a = np.linspace(0, 1e-7, 500)
emf = 1.5e8 * np.sin(2.4e8 * t_a)
ax1.plot(t_a * 1e9, emf / 1e3, color='#dc2626', linewidth=2)
ax1.set_title('Layer A: Induced EMF', fontsize=10, fontweight='bold')
ax1.set_ylabel('Voltage ($\text{kV}$)', fontsize=9)
ax1.grid(True, linestyle='--', alpha=0.5)

# --- PANEL 2: LAYER B (Vector Steering Convergence) ---
ax2 = fig.add_subplot(232, projection='3d')
np.random.seed(42)
for a in np.linspace(0, 2 * np.pi, 8, endpoint=False):
    start = np.array([5 * np.cos(a), 5 * np.sin(a), 0.5])
    track = np.array([start * (1 - t) for t in np.linspace(0, 1, 30)])
    ax2.plot(track[:, 0], track[:, 1], track[:, 2], color='#2563eb', alpha=0.7)
ax2.scatter(0, 0, 0, color='#d97706', s=100, marker='*')
ax2.set_title('Layer B: Vector Convergence ($\vec{X}_0$)', fontsize=10, fontweight='bold')

# --- PANEL 3: LAYER C (Resonant Neutron Bounded Energy) ---
ax3 = fig.add_subplot(233)
time_steps = np.linspace(0, 1, 50)
energy = 3.5 * np.exp(-1.5 * time_steps) + 0.5
ax3.plot(time_steps, energy, color='#7c3aed', linewidth=2.5, label='Mean Energy')
ax3.set_title('Layer C: Bounded Neutron Energy', fontsize=10, fontweight='bold')
ax3.set_ylabel('Energy State ($\text{MeV}$)', fontsize=9)
ax3.grid(True, linestyle='--', alpha=0.5)
ax3.legend(loc='upper right', frameon=True, fontsize=8)

plt.tight_layout(rect=[0, 0.03, 1, 0.92])
plt.show()

print("--- KINETIX-9 SYSTEM STATUS ---")
print("All 3 Core Layers active. Telemetry synchronization nominal.")
